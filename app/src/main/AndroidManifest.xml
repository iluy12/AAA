<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- שירות רקע (זיהוי הקשה) שרץ גם כשהמסך כבוי -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- הפעלה מחדש אחרי ריסטרט לשעון -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- להחזיק את המעבד ער במשך פרץ-דופק. האזעקה מעירה אותו רק לרגע מסירת
         ה-broadcast, ובלי זה הוא היה חוזר לישון לפני שהחיישן מסר דגימה
         אחת — כלומר הפרץ היה חוזר ריק וזה היה נראה כמו התקלה שבאנו לתקן. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- שאלה 9 בשאלון: הקלטה אישית -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- RISK B: חיוג ישיר לקו-הבדיקה -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- זיהוי חיוג ל-SOS. המסלול הוא לחיצה ארוכה על כפתור הצד → השעון
         מחייג למלווה, כלומר עוקף את האפליקציה — ובלי אלה האירוע לא קיים
         אצלנו למרות שהוא אות חזק. PROCESS_OUTGOING_CALLS נותן את המספר,
         READ_PHONE_STATE נותן את המשך, וששניהם יחד מבדילים בין חרטה
         אחרי צלצול לבין פנייה אמיתית. -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- "בבית או לא" — לא "איפה הוא". נקרא רק המיקום האחרון הידוע, בלי
         להדליק מקלט. ⚠️ חדר אינו ניתן לחישה בשום דיוק; מה שנמדד הוא האם
         הוא במקום שבו הוא נמצא בדרך כלל. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      זיהוי החדר: קריאת רשימת הרשתות שנראות בסביבה.

      ⚠️ **זו לא הרשאת רשת.** סריקה היא פעולת רדיו — השעון מקשיב מה
      משדר סביבו ולא מתחבר לכלום. INTERNET משמשת אך ורק את העלאת הלוג
      ואת העדכון העצמי, ואפשר להוריד אותה בלי לגעת בזיהוי החדר.

      ⚠️ **וזו הייתה הסיבה השנייה שזיהוי החדר לא עבד מעולם.** בלי
      ההרשאה הזו `getScanResults()` זורק חריגה, `runCatching` בולע
      אותה, והתוצאה זהה לחלוטין ל"אין רשתות בסביבה". חשבנו שהבעיה היא
      שה-WiFi כבוי בשעון — הייתה גם בעיה בקוד, והיא הוסתרה.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- worn-gating (מתעלמים מדפיקות כשהשעון לא על היד) — נפילה-חזרה
         לחיישן דופק אם אין off-body sensor ייעודי -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- התראת "עילוי שלחו לך סרטון" -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- פותח מסך במקום שורה נחתכת. ראו MessageActivity. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- פתיחת פאנלי המערכת (התראות, הגדרות מהירות) בהחלקה ממסך-השעון.
         הרשאה רגילה, נענית אוטומטית. נדרשת רק כי החלפנו את הלאנצ'ר של
         היצרן ואיתו את המחוות שהוא סיפק. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- ⚠️ נדרש רק להעלאת הלוג לבדיקות (LogUploader). האפליקציה עצמה
         לא צריכה רשת — כל האחסון מקומי. להסיר יחד עם כפתור שליחת-הלוג
         לפני הפצה למשתמשים. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- עדכון עצמי: הורדת גרסה חדשה והפעלת מתקין החבילות. ההתקנה עצמה
         תמיד עוברת דרך מסך האישור של אנדרואיד. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".IluyApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- מסך-השעון: מוצע כאפליקציית מסך-בית, כדי שלחיצה על הכפתור
             הצדדי תציג אותו ישירות בלי לפתוח שום דבר. המשתמש בוחר אותו
             ב־הגדרות ← אפליקציות ← ברירות מחדל ← מסך בית.
             stateAlwaysHidden: לא לפתוח מקלדת אף פעם על מסך 2 אינץ'. -->
        <activity
            android:name=".WatchFaceActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/WatchFaceTheme"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuestionnaireActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".RiskFlowActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".HelpMenuActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!--
          שני הכלים שהתשובה "כן" מובילה אליהם. showWhenLocked/turnScreenOn
          כמו במסכי ההתערבות האחרים: הם נפתחים מהודעה, ומסך כבוי היה הופך
          אותם לכפתור שלא מוביל לשום מקום.
        -->
        <!-- מסך הכיול. showWhenLocked/turnScreenOn כמו כל מסך שנפתח יזום,
             לא בתגובה למגע — בלעדיהם הוא נפתח מאחורי מסך כבוי ולא נראה. -->
        <activity
            android:name=".CheckInActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".MessageActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".RecordingActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".VideoActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".PlaceholderActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".TapAcknowledgedActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".MoodPickerActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- מגירת-אפליקציות. חובה כשעילוי משמשת מסך-בית: בלעדיה אין
             גישה לדפדפן, להגדרות ולשאר האפליקציות. -->
        <activity
            android:name=".AppDrawerActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <service
            android:name=".TapDetectorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- שאלת כן/לא שנפתחת מהודעה. exported=false — רק אנחנו פותחים
             אותה, ו"כן" מרימה שיחה, אז אין סיבה שאפליקציה אחרת תוכל. -->
        <activity
            android:name=".AskActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- אישור לדיווח נפילה שנעשה בלחיצה בלבד, בלי גרירה לקטגוריה. -->
        <activity
            android:name=".FallConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- בחירת סוג נפילה במסך מלא. ⚠️ חייב מסך שלם — ראו הערת-המחלקה. -->
        <activity
            android:name=".FallPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- ⚠️ מסך אימות זמני לתקופת הכיול. אמור לרדת לפני הפצה. -->
        <activity
            android:name=".StatusActivity"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- מקבל את האזעקה השעתית של התזכורת לדווח. exported=false — רק
             AlarmManager שלנו מפעיל אותו, אין סיבה שאפליקציה אחרת תוכל. -->
        <receiver
            android:name=".ReportReminder$Receiver"
            android:exported="false" />

        <!-- מקבל את אזעקת פרץ-הדופק. -->
        <receiver
            android:name=".HeartRateSampler$Receiver"
            android:exported="false" />

        <!-- ההודעה המעודדת שמגיעה 5-15 דקות אחרי דיווח נפילה. -->
        <receiver
            android:name=".FallReport$Receiver"
            android:exported="false" />

        <!-- שיחה יוצאת. exported=true נדרש כאן — זו שידורית של המערכת,
             לא שלנו, ורק המערכת יכולה לשלוח אותה בזכות ההרשאה. -->
        <receiver
            android:name=".SosCallWatcher$OutgoingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
